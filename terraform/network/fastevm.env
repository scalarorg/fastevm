# FastEVM Configuration
# Merged configuration file for both main deployment and client node testing
# Generated on: $(date)

# =============================================================================
# REPOSITORY CONFIGURATION
# =============================================================================
GITHUB_REPO=https://github.com/scalarorg/fastevm.git
# GITHUB_BRANCH=optimize-execution
GITHUB_BRANCH=terraform-gravity
CHAIN_ID=202501

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
PROJECT_NAME=fastevm
PROJECT_ID=scalar-459101
NODE_COUNT=4
REGION=us-central1
ZONE=us-central1-c
# REGION=asia-southeast1
# ZONE=asia-southeast1-c
# MACHINE_TYPE=e2-highmem-8
# MACHINE_TYPE=e2-highcpu-32
# For dev
# MACHINE_TYPE=e2-standard-4
# For e2-standard-4, use: pd-standard, pd-ssd, or pd-balanced
# DISK_TYPE=pd-standard

# High performance
# MACHINE_TYPE=c4-highcpu-16
MACHINE_TYPE=c4-standard-4
DISK_TYPE=hyperdisk-balanced
# DISK_TYPE options: pd-standard, pd-ssd, pd-balanced
# Note: hyperdisk-balanced requires N1/N2/C2/C3/M1/M2/M3 machine types

LOG_LEVEL=vvvv

# =============================================================================
# PREFUNDED ACCOUNTS CONFIGURATION
# =============================================================================
PREFUND_ACCOUNT_COUNT=100000
PREFUND_BALANCE=1000000000000000000000
TEST_MNEMONIC='abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about'

# =============================================================================
# BLOCKCHAIN CONFIGURATION
# =============================================================================
DATA_DIR=/data
BLOCK_GAS_LIMIT=630000000 # 30k txs/block 3s
SUBDAGS_PER_BLOCK=30
BLOCK_BUILD_INTERVAL=1000

# Database sync mode configuration
# Options: durable (default, safest), nometasync (better performance), safenosync (higher performance), utterlynosync (maximum performance, risky)
DB_SYNC_MODE=safenosync

# =============================================================================
# TEST CONFIGURATION
# =============================================================================
# Batch Transaction Test Parameters
TEST_SENDER_COUNT=100000
TEST_TRANSACTION_COUNT=4
TEST_TRANSACTION_VALUE=1000000000000000

# Test Behavior Configuration
TEST_FETCH_NONCE=true
TEST_WAITING_TIME_SECONDS=30
TEST_RPC_TIMEOUT=30
TEST_MAX_RETRIES=3
TEST_LOG_LEVEL=info
