# FastEVM Dev Node Configuration
# Copy this file to .env and modify as needed
# The .env file is automatically loaded by deploy.sh

# Reth binary type: 'gravity' or 'reth' (default: reth)
RETH_TYPE=reth

# Database sync mode: durable, nometasync, safenosync, utterlynosync
# Controls how aggressively the database synchronizes data to disk
# - durable: Safest, full synchronization (default)
# - nometasync: Good balance of performance and safety
# - safenosync: Higher performance with some safety guarantees
# - utterlynosync: Maximum performance, data loss acceptable (testing only)
DB_SYNC_MODE=nometasync

# HTTP RPC port (default: 8545)
HTTP_PORT=8545

# WebSocket RPC port (default: 8546)
WS_PORT=8546

# Engine API port (default: 8551)
ENGINE_PORT=8551

# P2P port (default: 30303)
P2P_PORT=30303

# Block time interval for dev mode (default: 1s, e.g., 12s, 2s)
# Block time interval for dev mode (default: 1s, e.g., 12s, 2s)
DEV_BLOCK_TIME=

# Max transactions per block
DEV_BLOCK_MAX_TXNS=

# Block gas limit (default: 240000000)
BUILDER_GAS_LIMIT=240000000

# Log level: trace, debug, info, warn, error (default: debug)
LOG_LEVEL=debug

# Machine Type Configuration
# These will be passed to Terraform as TF_VAR_execution_machine_type and TF_VAR_client_machine_type
# Examples:
#   - c4-highcpu-16 (16 vCPUs, high CPU)
#   - e2-standard-8 (8 vCPUs, 32GB RAM)
#   - n2-standard-8 (8 vCPUs, 32GB RAM, Intel Cascade Lake)
EXECUTION_MACHINE_TYPE=c4-highcpu-16
CLIENT_MACHINE_TYPE=e2-standard-8


# Execution node local SSD count (NVMe disks, default: 0)
# Note: Not all machine types support local SSDs (e.g., c4-highcpu-16 does not support them)
# Machine types that DO support local SSDs: n1-standard-*, n2-standard-*, n2d-standard-*, c2-standard-*, etc.
# This determines how many local SSD disks are attached to the execution node
EXECUTION_LOCAL_SSD_COUNT=0
